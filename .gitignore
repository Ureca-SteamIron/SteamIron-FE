# --- 비밀 설정 (절대 커밋 금지) ---
.env
.env.*
!.env.example
# .env.production은 시크릿이 아니라 배포용 API 주소만 담음 → 커밋해서 배포 빌드에 자동 반영
!.env.production

# --- 의존성 / 빌드 ---
node_modules/
dist/
build/
.vite/

# --- IDE ---
.idea/
.vscode/*
!.vscode/extensions.json

# --- OS ---
.DS_Store
Thumbs.db

# --- 로그 ---
*.log
npm-debug.log*

# --- AI 에이전트 스킬 (각자 npx skills add로 설치) ---
.agents/
.claude/
skills-lock.json
